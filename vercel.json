    { "source": "/projecten", "destination": "/projecten.html", "permanent": true },
    { "source": "/lichtberekeningen", "destination": "/lichtberekeningen.html", "permanent": true },
    { "source": "/blog/:pad*", "destination": "/nieuws.html", "permanent": true },
